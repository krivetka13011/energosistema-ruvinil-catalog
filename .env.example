# Скопируйте в .env и при необходимости заполните (файл .env в git не коммитится).
# Для постоянной работы агента чаще достаточно разового `gh auth login` или переменной GH_TOKEN
# в среде пользователя Windows — см. docs/ONE-TIME-SETUP.md

# Опционально: тот же токен, что для GitHub (repo). Если задан, gh использует его автоматически.
# GH_TOKEN=

# Абсолютный URL сайта для Astro (канонические ссылки). В CI задайте как Variables в GitHub Actions.
# PUBLIC_SITE_URL=https://example.pages.dev

# Локально при ручном деплое в Cloudflare (в CI лучше GitHub Secrets — см. docs/ONE-TIME-SETUP.md)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Параметры парсера (переопределение значений по умолчанию)
# SCRAPE_MAX_PAGES=   # не задавать — без лимита; только для теста, напр. 120
# SCRAPE_DELAY_MS=450
