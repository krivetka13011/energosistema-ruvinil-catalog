---
import Layout from "../../layouts/Layout.astro";
import CategorySectionCard from "../../components/CategorySectionCard.astro";
import ProductCard from "../../components/ProductCard.astro";
import type { CatalogCategory } from "../../types/catalog";
import {
  catalog,
  categoryRepresentativeImage,
  childCategoriesOrdered,
  normalizePath,
  productsInCategory,
  productsInCategoryTree,
  sortProductsInCategoryTree,
} from "../../utils/catalog";
import { baseUrl } from "../../utils/baseUrl";

export function getStaticPaths() {
  return catalog.categories.map((c) => ({ params: { slug: c.slug } }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.params as Props;

const cat = catalog.categories.find((c) => c.slug === slug);
if (!cat) throw new Error(`Unknown category slug: ${slug}`);

const byPath = new Map(catalog.categories.map((c) => [normalizePath(c.pathname), c]));

function breadcrumbChain(category: CatalogCategory): CatalogCategory[] {
  const out: CatalogCategory[] = [];
  let cur: CatalogCategory | undefined = category;
  while (cur) {
    out.unshift(cur);
    const pp = cur.parentPath ? normalizePath(cur.parentPath) : "/catalog/";
    if (pp === "/catalog/") break;
    cur = byPath.get(pp);
    if (!cur) break;
  }
  return out;
}

const chain = breadcrumbChain(cat);
const children = childCategoriesOrdered(catalog.categories, cat.pathname);
const direct = productsInCategory(catalog.products, cat.pathname);
const inTree = productsInCategoryTree(catalog.products, catalog.categories, cat.pathname);
const shown = sortProductsInCategoryTree(inTree);
---

<Layout
  title={`${cat.title} — каталог ${catalog.company.name}`}
  description={`${cat.title}: ${inTree.length} позиций в дереве раздела.`}
  catalog={catalog}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10">
      <nav class="reveal flex flex-wrap gap-x-2 gap-y-1 text-sm text-slate-500">
        <a href={baseUrl("/")} class="hover:text-brand-700">Главная</a>
        <span>/</span>
        <a href={baseUrl("/catalog/")} class="hover:text-brand-700">Каталог</a>
        {
          chain.map((c, i) => (
            <>
              <span>/</span>
              {i === chain.length - 1 ? (
                <span class="text-slate-800">{c.title}</span>
              ) : (
                <a href={baseUrl(`/catalog/${c.slug}/`)} class="hover:text-brand-700">
                  {c.title}
                </a>
              )}
            </>
          ))
        }
      </nav>
      <h1 class="reveal mt-4 font-display text-3xl font-bold text-brand-950 md:text-4xl">{cat.title}</h1>
      <p class="reveal mt-3 text-slate-600">
        В этом разделе: <span class="font-semibold text-brand-900">{direct.length}</span> поз. напрямую ·{" "}
        <span class="font-semibold text-brand-900">{inTree.length}</span> с учётом подразделов.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    {
      children.length ? (
        <>
          <h2 class="reveal font-display text-xl font-semibold text-brand-900">Подразделы</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {children.map((c) => (
              <CategorySectionCard
                href={baseUrl(`/catalog/${c.slug}/`)}
                title={c.title}
                image={categoryRepresentativeImage(catalog.categories, catalog.products, c.pathname)}
                subtitle={`${productsInCategoryTree(catalog.products, catalog.categories, c.pathname).length} поз.`}
              />
            ))}
          </div>
        </>
      ) : null
    }

    <div class={children.length ? "mt-14" : ""}>
      <h2 class="reveal font-display text-xl font-semibold text-brand-900">Товары</h2>
      {
        shown.length === 0 ? (
          <p class="reveal mt-4 text-sm text-slate-600">
            В этом узле пока нет позиций в данных каталога — возможно, только подразделы или листинг ещё не собирался
            парсером.
          </p>
        ) : (
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {shown.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>
