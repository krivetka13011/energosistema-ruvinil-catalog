---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { catalog, childCategories, descendantProducts } from "../../utils/catalog";

const roots = childCategories(catalog.categories, "/catalog/");
---

<Layout
  title={`Каталог — ${catalog.company.name}`}
  description={`Электротехническая продукция: ${catalog.products.length} позиций.`}
  catalog={catalog}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <nav class="reveal text-sm text-slate-500">
        <a href="/" class="hover:text-brand-700">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800">Каталог</span>
      </nav>
      <h1 class="reveal mt-4 font-display text-4xl font-bold text-brand-950">Каталог</h1>
      <p class="reveal mt-3 max-w-3xl text-slate-600">
        Выберите раздел. Карточки содержат артикулы и ключевые свойства по данным каталога производителя.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        roots.map((c) => (
          <a
            href={`/catalog/${c.slug}/`}
            class="reveal rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-brand-600/25 hover:shadow-soft"
          >
            <h2 class="font-display text-xl font-semibold text-brand-900">{c.title}</h2>
            <p class="mt-2 text-sm text-slate-500">
              Позиций в дереве: {descendantProducts(catalog.products, c.pathname).length}
            </p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-700">Открыть →</span>
          </a>
        ))
      }
    </div>

    <div class="reveal mt-16">
      <h2 class="font-display text-2xl font-bold text-brand-950">Все товары списком</h2>
      <p class="mt-2 text-sm text-slate-600">
        Полный перечень после синхронизации парсера по всем разделам каталога поставщика.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {catalog.products.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>
</Layout>
