---
import Layout from "../../layouts/Layout.astro";
import CatalogSearch from "../../components/CatalogSearch.astro";
import CategorySectionCard from "../../components/CategorySectionCard.astro";
import {
  catalog,
  categoryRepresentativeImage,
  childCategoriesOrdered,
  productsInCategoryTree,
} from "../../utils/catalog";
import { baseUrl } from "../../utils/baseUrl";

const roots = childCategoriesOrdered(catalog.categories, "/catalog/");
---

<Layout
  title={`Каталог — ${catalog.company.name}`}
  description={`Электротехническая продукция: ${catalog.products.length} позиций.`}
  catalog={catalog}
>
  <section class="catalog-supplier-bg text-white">
    <div class="mx-auto max-w-7xl px-4 pb-6 pt-10 md:pb-8 md:pt-14">
      <nav class="reveal text-sm text-sky-100/90">
        <a href={baseUrl("/")} class="transition hover:text-white hover:underline">Главная</a>
        <span class="mx-2 opacity-70">→</span>
        <span class="font-medium text-white">Каталог</span>
      </nav>
      <h1 class="reveal mt-6 max-w-4xl font-display text-3xl font-bold leading-tight tracking-tight md:text-4xl lg:text-[2.75rem]">
        Каталог электротехнической продукции
      </h1>
      <p class="reveal mt-4 max-w-2xl text-base text-sky-50/95 md:text-lg">
        Выберите раздел. Ассортимент и цены уточняйте по телефону или e-mail — или оформите заявку через корзину.
      </p>
      <p class="reveal mt-6">
        <a
          href={baseUrl("/cart/")}
          class="inline-flex rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-brand-900 shadow-sm transition hover:bg-sky-50"
        >
          Корзина
        </a>
      </p>
    </div>

    <div class="relative z-20 mx-auto max-w-7xl overflow-visible px-4 pb-8">
      <div class="reveal overflow-visible rounded-2xl bg-white p-4 shadow-lg ring-1 ring-slate-200/80 md:p-5">
        <CatalogSearch />
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 pb-14 md:pb-20">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          roots.map((c) => (
            <div class="reveal text-slate-900">
              <CategorySectionCard
                href={baseUrl(`/catalog/${c.slug}/`)}
                title={c.title}
                image={categoryRepresentativeImage(catalog.categories, catalog.products, c.pathname)}
                subtitle={`${productsInCategoryTree(catalog.products, catalog.categories, c.pathname).length} позиций`}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
