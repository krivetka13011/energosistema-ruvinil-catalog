---
import Layout from "../layouts/Layout.astro";
import { catalog } from "../utils/catalog";
import { baseUrl } from "../utils/baseUrl";


---

<Layout
  title={`Сравнение товаров — ${catalog.company.name}`}
  description="Сравнение выбранных электротехнических товаров."
  catalog={catalog}
  noindex
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-8">
      <h1 class="font-display text-3xl font-bold text-brand-950 md:text-4xl">Сравнение товаров</h1>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12">
    <div id="compare-container" class="overflow-x-auto pb-8">
    </div>
  </section>
</Layout>

<script>
  import { catalog } from "../utils/catalog";
  const products = catalog.products.map(p => ({
    slug: p.slug,
    title: p.title,
    image: p.images[0] || p.image || "",
    properties: p.properties,
    priceHint: p.priceHint,
    url: "/p/" + p.slug + "/"
  }));
  import { getCompareItems, removeFromCompare } from "../scripts/compare-storage.ts";

  function renderCompare() {
    const container = document.getElementById("compare-container");
    if (!container) return;

    const slugs = getCompareItems();
    if (slugs.length === 0) {
      container.innerHTML = `
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-500">
          <p class="text-lg">Нет товаров для сравнения</p>
          <a href="/catalog/" class="mt-4 inline-block font-semibold text-brand-600 hover:underline">Перейти в каталог</a>
        </div>`;
      return;
    }

    const items = slugs.map((s: string) => products.find((p: any) => p.slug === s)).filter(Boolean);
    const keysSet = new Set<string>();
    items.forEach((it: any) => {
      Object.keys(it.properties || {}).forEach(k => keysSet.add(k));
    });
    const keys = Array.from(keysSet).sort();

    let thead = `<tr><th class="p-4 border-b border-slate-200 min-w-[200px] w-64 bg-slate-50 text-left font-medium text-slate-500">Свойства</th>`;
    items.forEach((it: any) => {
      thead += `
        <th class="p-4 border-b border-l border-slate-200 min-w-[240px] w-72 bg-white text-left align-top">
          <div class="relative flex flex-col gap-3">
            <button class="remove-btn absolute -right-2 -top-2 rounded-full bg-slate-100 p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-500" data-slug="${it.slug}" title="Удалить">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div class="h-32 w-full rounded-xl bg-slate-50 flex items-center justify-center overflow-hidden p-2">
              ${it.image ? `<img src="${it.image}" class="h-full w-full object-contain mix-blend-multiply" />` : '<span class="text-xs text-slate-400">Нет фото</span>'}
            </div>
            <a href="${it.url}" class="font-display text-sm font-semibold leading-snug text-brand-900 hover:text-brand-600 hover:underline line-clamp-3">${it.title}</a>
            <div class="text-xs font-semibold text-emerald-700">${it.priceHint || ''}</div>
          </div>
        </th>
      `;
    });
    thead += `</tr>`;

    let tbody = '';
    keys.forEach(k => {
      tbody += `<tr><td class="p-4 border-b border-slate-100 bg-slate-50 text-sm text-slate-600 font-medium">${k}</td>`;
      items.forEach((it: any) => {
        const val = it.properties?.[k] || "—";
        tbody += `<td class="p-4 border-b border-l border-slate-100 text-sm text-slate-900 bg-white">${val}</td>`;
      });
      tbody += `</tr>`;
    });

    container.innerHTML = `
      <table class="w-full border-collapse rounded-2xl overflow-hidden ring-1 ring-slate-200">
        <thead>${thead}</thead>
        <tbody>${tbody}</tbody>
      </table>
    `;

    container.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const slug = target.dataset.slug;
        if (slug) removeFromCompare(slug);
      });
    });
  }

  renderCompare();
  window.addEventListener("compare:updated", renderCompare);
  document.addEventListener("astro:after-swap", renderCompare);
</script>
