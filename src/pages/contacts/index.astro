---
import Layout from "../../layouts/Layout.astro";
import { catalog } from "../../utils/catalog";

const { company } = catalog;
---

<Layout
  title={`Контакты — ${company.name}`}
  description={`${company.contacts.address}. Телефон ${company.contacts.phone}, email ${company.contacts.email}`}
  catalog={catalog}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h1 class="reveal font-display text-4xl font-bold text-brand-950">Контакты</h1>
      <p class="reveal mt-3 max-w-2xl text-lg text-slate-600">
        Основной офис в Москве. Заявки и консультации по каталогу — по телефону или почте.
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-2">
    <div class="reveal space-y-6 rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
      <h2 class="font-display text-xl font-semibold text-brand-900">Реквизиты для связи</h2>
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Адрес</dt>
          <dd class="mt-1 text-base text-slate-800">{company.contacts.address}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Телефон</dt>
          <dd class="mt-1">
            <a class="text-lg font-semibold text-brand-800 hover:underline" href={`tel:${company.contacts.phone.replace(/[^\d+]/g, "")}`}>
              {company.contacts.phone}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">E-mail</dt>
          <dd class="mt-1">
            <a class="text-lg font-semibold text-brand-800 hover:underline" href={`mailto:${company.contacts.email}`}>
              {company.contacts.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Режим работы</dt>
          <dd class="mt-1 text-base text-slate-800">{company.contacts.hours}</dd>
        </div>
      </dl>
    </div>
    <div class="reveal flex flex-col justify-between gap-6 rounded-3xl border border-slate-200 bg-slate-50 p-8">
      <div>
        <h2 class="font-display text-xl font-semibold text-brand-900">Заказ и консультация</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Сообщите артикул из карточки товара или пришлите список позиций на почту — подготовим предложение по розничным
          условиям.
        </p>
      </div>
      <div class="rounded-2xl bg-brand-900 p-6 text-white shadow-soft">
        <p class="text-sm text-slate-200">Каталог производителя для справки:</p>
        <a
          href={company.supplier.catalogUrl}
          class="mt-2 inline-flex font-semibold text-red-100 underline-offset-2 hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          {company.supplier.catalogUrl}
        </a>
      </div>
    </div>
  </section>
</Layout>
