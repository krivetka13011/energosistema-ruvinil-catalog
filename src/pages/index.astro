---
import Layout from "../layouts/Layout.astro";
import CategorySectionCard from "../components/CategorySectionCard.astro";
import ProductCard from "../components/ProductCard.astro";
import {
  catalog,
  categoryRepresentativeImage,
  childCategoriesOrdered,
  productsInCategoryTree,
} from "../utils/catalog";
import { baseUrl } from "../utils/baseUrl";

const roots = childCategoriesOrdered(catalog.categories, "/catalog/");
const featured = [...catalog.products].sort((a, b) => a.slug.localeCompare(b.slug, "ru")).slice(0, 8);
const total = catalog.products.length;
---

<Layout
  title={`${catalog.company.name} — каталог электротехники`}
  description={`Каталог электротехнической продукции. ${total} позиций. ${catalog.company.contacts.phone}`}
  catalog={catalog}
>
  <section class="mesh-bg text-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-16 md:flex-row md:items-center md:py-24">
      <div class="reveal flex-1 space-y-6">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red-200/90">Каталог</p>
        <h1 class="font-display text-4xl font-bold leading-tight tracking-tight md:text-5xl">
          Современная витрина ассортимента электротехники
        </h1>
        <p class="max-w-xl text-lg text-slate-200/95">
          Подбор коробок, труб, кабель-каналов и щитового оборудования с актуальными артикулами и описаниями —
          оформление через корзину, по телефону или почте{" "}
          <span class="whitespace-nowrap font-semibold text-white">{catalog.company.contacts.phone}</span>.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={baseUrl("/catalog/")}
            class="rounded-full bg-white px-6 py-3 font-semibold text-brand-900 shadow-soft transition hover:bg-slate-100"
          >
            Открыть каталог
          </a>
          <a
            href={baseUrl("/cart/")}
            class="rounded-full border border-white/30 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
          >
            Корзина
          </a>
          <a
            href={baseUrl("/contacts/")}
            class="rounded-full border border-white/30 px-6 py-3 font-semibold text-white transition hover:bg-white/10"
          >
            Контакты
          </a>
        </div>
      </div>
      <div class="reveal flex flex-1 justify-center md:justify-end">
        <div class="w-full max-w-md rounded-3xl border border-white/15 bg-white/10 p-6 backdrop-blur-md">
          <div class="font-display text-sm font-semibold text-red-100">Сводка</div>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4 border-b border-white/10 pb-3">
              <dt class="text-slate-300">Позиций в базе</dt>
              <dd class="font-semibold">{total}</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-white/10 pb-3">
              <dt class="text-slate-300">Разделов верхнего уровня</dt>
              <dd class="font-semibold">{roots.length}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-300">Обновление данных</dt>
              <dd class="font-semibold text-right">
                {new Date(catalog.generatedAt).toLocaleDateString("ru-RU")}
              </dd>
            </div>
          </dl>
          <p class="mt-6 text-xs leading-relaxed text-slate-300">{catalog.company.legalNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="reveal flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="font-display text-3xl font-bold text-brand-950">Разделы каталога</h2>
        <p class="mt-2 max-w-2xl text-slate-600">
          Разделы и артикулы синхронизируются со службой данных — навигация остаётся привычной для монтажников и закупки.
        </p>
      </div>
      <a href={baseUrl("/catalog/")} class="text-sm font-semibold text-brand-700 hover:underline">Все разделы →</a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        roots.map((c) => (
          <div class="reveal">
            <CategorySectionCard
              href={baseUrl(`/catalog/${c.slug}/`)}
              title={c.title}
              image={categoryRepresentativeImage(catalog.categories, catalog.products, c.pathname)}
              subtitle={`${productsInCategoryTree(catalog.products, catalog.categories, c.pathname).length} поз.`}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="reveal flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="font-display text-3xl font-bold text-brand-950">Подборка из каталога</h2>
          <p class="mt-2 text-slate-600">Случайные позиции после последнего обновления данных.</p>
        </div>
        <a href={baseUrl("/catalog/")} class="text-sm font-semibold text-brand-700 hover:underline">Перейти в каталог →</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>
</Layout>
