---
import Layout from "../../layouts/Layout.astro";
import { catalog } from "../../utils/catalog";
import { baseUrl } from "../../utils/baseUrl";
---

<Layout
  title={`Отложенное — ${catalog.company.name}`}
  description="Список отложенных товаров для заявки менеджеру."
  catalog={catalog}
>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-12">
      <nav class="text-sm text-slate-500">
        <a href={baseUrl("/")} class="hover:text-brand-700">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800">Отложенное</span>
      </nav>
      <h1 class="mt-4 font-display text-3xl font-bold text-brand-950 md:text-4xl">Отложенное</h1>
      <p class="mt-2 text-slate-600">
        Список хранится только в вашем браузере. Для заказа позвоните или напишите менеджеру и сообщите артикулы.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={`tel:${catalog.company.contacts.phone.replace(/[^\d+]/g, "")}`}
          class="rounded-full bg-brand-900 px-5 py-2.5 text-sm font-semibold text-white shadow-soft hover:bg-brand-800"
        >
          {catalog.company.contacts.phone}
        </a>
        <a
          href={`mailto:${catalog.company.contacts.email}?subject=Заявка по отложенным позициям`}
          class="rounded-full border border-slate-200 px-5 py-2.5 text-sm font-semibold text-brand-900 hover:bg-slate-50"
        >
          Написать на почту
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10">
    <div id="deferred-list-root" class="space-y-4"></div>
  </section>

  <script>
    import "../../scripts/deferred-list-page.ts";
  </script>
</Layout>
