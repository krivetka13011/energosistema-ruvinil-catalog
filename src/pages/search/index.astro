---
import Layout from "../../layouts/Layout.astro";
import { catalog } from "../../utils/catalog";
import { baseUrl } from "../../utils/baseUrl";
---

<Layout
  title={`Поиск по каталогу — ${catalog.company.name}`}
  description="Поиск товаров по названию, артикулу и свойствам."
  catalog={catalog}
>
  <section class="border-b border-slate-200 bg-white" data-search-page>
    <div class="mx-auto max-w-3xl px-4 py-12">
      <nav class="text-sm text-slate-500">
        <a href={baseUrl("/")} class="hover:text-brand-700">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800">Поиск</span>
      </nav>
      <h1 class="mt-4 font-display text-3xl font-bold text-brand-950 md:text-4xl">Поиск по каталогу</h1>
      <p class="mt-2 text-slate-600">
        Учитываются название, артикул и текст характеристик. Несколько слов через пробел — все должны встречаться в карточке.
      </p>
      <p id="catalog-search-meta" class="mt-2 text-xs text-slate-400"></p>
      <label class="mt-6 block">
        <span class="sr-only">Запрос</span>
        <input
          id="catalog-search-input"
          type="search"
          autocomplete="off"
          placeholder="Например: гофра 16 мм или артикул 11601"
          class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-base text-brand-950 shadow-inner outline-none ring-brand-600/30 placeholder:text-slate-400 focus:border-brand-600 focus:bg-white focus:ring-2"
        />
      </label>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10">
    <div id="catalog-search-results" class="min-h-[4rem] text-sm">
      <p class="text-slate-500">Введите название, артикул или слово из характеристик.</p>
    </div>
  </section>

  <script>
    import "../../scripts/search-page-ui.ts";
  </script>
</Layout>
