---
import Layout from "../../layouts/Layout.astro";
import AddToCartButton from "../../components/AddToCartButton.astro";
import { catalog, normalizePath, productPrimaryImage } from "../../utils/catalog";
import { catalogPriceLabelForCart, catalogUnitPriceRub } from "../../utils/price";
import type { CatalogCategory } from "../../types/catalog";
import { baseUrl } from "../../utils/baseUrl";

export function getStaticPaths() {
  return catalog.products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params as { slug: string };

const product = catalog.products.find((p) => p.slug === slug);
if (!product) throw new Error(`Unknown product slug: ${slug}`);

const byPath = new Map(catalog.categories.map((c) => [normalizePath(c.pathname), c]));

function breadcrumbForProduct(categoryPath: string): CatalogCategory[] {
  const cp = normalizePath(categoryPath);
  const cat = catalog.categories.find((c) => normalizePath(c.pathname) === cp);
  if (!cat) return [];
  const out: CatalogCategory[] = [];
  let cur: CatalogCategory | undefined = cat;
  while (cur) {
    out.unshift(cur);
    const pp = cur.parentPath ? normalizePath(cur.parentPath) : "/catalog/";
    if (pp === "/catalog/") break;
    cur = byPath.get(pp);
    if (!cur) break;
  }
  return out;
}

const chain = breadcrumbForProduct(product.categoryPath);
const sku = product.properties["Артикул"] ?? "";
const primaryImg = productPrimaryImage(product);
const unitRub = catalogUnitPriceRub(product);
const priceLabel = catalogPriceLabelForCart(product);
const galleryImages = product.images.length ? product.images : primaryImg ? [primaryImg] : [];
---

<Layout
  title={`${product.title} — ${catalog.company.name}`}
  description={product.descriptionHtml ? undefined : `${product.title}. ${sku ? `Артикул ${sku}.` : ""} Заказ: ${catalog.company.contacts.phone}`}
  catalog={catalog}
>
  <article class="mx-auto max-w-6xl px-4 py-12">
    <nav class="reveal flex flex-wrap gap-x-2 gap-y-1 text-sm text-slate-500">
      <a href={baseUrl("/")} class="hover:text-brand-700">Главная</a>
      <span>/</span>
      <a href={baseUrl("/catalog/")} class="hover:text-brand-700">Каталог</a>
      {
        chain.map((c) => (
          <>
            <span>/</span>
            <a href={baseUrl(`/catalog/${c.slug}/`)} class="hover:text-brand-700">
              {c.title}
            </a>
          </>
        ))
      }
      <span>/</span>
      <span class="text-slate-800">Карточка</span>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="reveal space-y-4">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          {
            galleryImages.length ? (
              <div class="grid gap-4 sm:grid-cols-2">
                {galleryImages.map((src) => (
                  <img
                    src={src}
                    alt=""
                    class="max-h-72 w-full rounded-2xl bg-slate-50 object-contain p-4"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                  />
                ))}
              </div>
            ) : (
              <div class="flex h-64 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">Нет изображения</div>
            )
          }
        </div>
        <p class="text-xs text-slate-400">
          Если изображение не отображается, обновите страницу или сообщите менеджеру — проверим файл на стороне каталога.
        </p>
      </div>

      <div class="reveal space-y-6">
        <div>
          {sku ? (
            <p class="text-sm font-semibold uppercase tracking-wide text-accent">Артикул {sku}</p>
          ) : null}
          <h1 class="mt-2 font-display text-3xl font-bold leading-tight text-brand-950 md:text-4xl">{product.title}</h1>
          {product.availability ? <p class="mt-3 text-sm font-medium text-emerald-700">{product.availability}</p> : null}
          {product.priceHint ? <p class="mt-4 text-2xl font-semibold text-brand-900">{product.priceHint}</p> : (
            <p class="mt-4 text-lg text-slate-600">Оптовые цены уточняйте у менеджера.</p>
          )}
          <div class="mt-6 max-w-md">
            <AddToCartButton
              slug={product.slug}
              title={product.title}
              sku={sku}
              image={primaryImg}
              unitPriceRub={unitRub}
              priceDisplay={priceLabel}
            />
          </div>
        </div>

        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-lg font-semibold text-brand-900">Характеристики</h2>
          <dl class="mt-4 divide-y divide-slate-100 text-sm">
            {
              Object.entries(product.properties).map(([k, v]) => (
                <div class="flex gap-4 py-2">
                  <dt class="w-2/5 shrink-0 text-slate-500">{k}</dt>
                  <dd class="font-medium text-slate-900">{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="rounded-3xl bg-brand-900 p-6 text-white shadow-soft">
          <p class="text-sm text-slate-200">Заказ и консультация</p>
          <a class="mt-2 block text-xl font-semibold hover:underline" href={`tel:${catalog.company.contacts.phone.replace(/[^\d+]/g, "")}`}>
            {catalog.company.contacts.phone}
          </a>
          <a class="mt-2 block text-sm font-semibold text-red-100 hover:underline" href={`mailto:${catalog.company.contacts.email}`}>
            {catalog.company.contacts.email}
          </a>
        </div>

        {
          product.descriptionHtml ? (
            <div class="rounded-3xl border border-slate-200 bg-white p-6">
              <h2 class="font-display text-lg font-semibold text-brand-900">Описание</h2>
              <div class="catalog-html mt-3 max-w-none text-sm leading-relaxed text-slate-700" set:html={product.descriptionHtml} />
            </div>
          ) : null
        }

      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .catalog-html img {
    max-width: 100%;
    height: auto;
  }
</style>
