---
import categoryImageScale from "../data/categoryImageScale.json";

export interface Props {
  href: string;
  title: string;
  image?: string;
  /** Короткая строка под заголовком (например число позиций) */
  subtitle?: string;
}

const { href, title, image = "", subtitle } = Astro.props;

const scales = categoryImageScale as Record<string, number>;
const rawScale = image ? scales[image] : undefined;
const scale =
  typeof rawScale === "number" && Number.isFinite(rawScale) && rawScale >= 1.002
    ? Math.round(rawScale * 1000) / 1000
    : 1;
---

<a
  href={href}
  class="group flex h-[388px] w-full flex-col overflow-hidden rounded-2xl border border-sky-200/80 bg-sky-100/95 shadow-sm outline-none transition hover:border-sky-300 hover:bg-sky-50 hover:shadow-md focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 focus-visible:ring-offset-[#2a6a9e]"
>
  <div class="flex h-[168px] min-h-0 shrink-0 flex-col px-4 pb-3 pt-5">
    <h2
      class="line-clamp-4 font-display text-lg font-semibold leading-snug text-brand-950 group-hover:text-brand-800 md:text-xl"
    >
      {title}
    </h2>
    {
      subtitle ? (
        <p class="mt-2 line-clamp-2 shrink-0 text-sm leading-snug text-slate-600">{subtitle}</p>
      ) : null
    }
  </div>
  <!-- Только зона фото: превью прижато к низу как у ruvinil -->
  <div class="relative h-[220px] shrink-0 bg-white">
    {
      image ? (
        <div class="absolute inset-x-3 inset-y-2 flex flex-col justify-end overflow-hidden">
          <img
            src={image}
            alt=""
            width={280}
            height={200}
            class="supplier-category-photo"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            style={scale > 1.002 ? { "--category-photo-scale": String(scale) } : undefined}
          />
        </div>
      ) : (
        <div class="flex h-full items-center justify-center gap-1 text-center text-sm text-slate-400">
          <span class="text-2xl opacity-40" aria-hidden="true">◇</span>
          <span>Нет фото</span>
        </div>
      )
    }
  </div>
</a>
