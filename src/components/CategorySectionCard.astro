---
export interface Props {
  href: string;
  title: string;
  image?: string;
  /** Короткая строка под заголовком (например число позиций) */
  subtitle?: string;
}

const { href, title, image = "", subtitle } = Astro.props;

const isSvgThumb = image.startsWith("data:image/svg+xml");
---

<a
  href={href}
  class="group flex h-[388px] w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm outline-none transition hover:border-brand-600/25 hover:bg-slate-50/90 hover:shadow-md focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 focus-visible:ring-offset-white"
>
  <div class="flex h-[168px] min-h-0 shrink-0 flex-col bg-white px-4 pb-3 pt-5">
    <h2
      class="line-clamp-4 font-display text-lg font-semibold leading-snug text-brand-950 group-hover:text-brand-800 md:text-xl"
    >
      {title}
    </h2>
    {
      subtitle ? (
        <p class="mt-2 line-clamp-2 shrink-0 text-sm leading-snug text-slate-600">{subtitle}</p>
      ) : null
    }
  </div>
  <div class="relative h-[220px] shrink-0 overflow-hidden bg-white">
    {
      image ? (
        isSvgThumb ? (
          <div class="absolute inset-0 flex items-center justify-center bg-white p-6">
            <img
              src={image}
              alt=""
              width={280}
              height={200}
              class="supplier-category-svg-thumb max-h-full max-w-full object-contain"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </div>
        ) : (
          <div class="absolute inset-0 overflow-hidden bg-white">
            <img
              src={image}
              alt=""
              width={280}
              height={200}
              class="supplier-category-photo h-full w-full min-h-0 min-w-0"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </div>
        )
      ) : (
        <div class="flex h-full items-center justify-center gap-1 text-center text-sm text-slate-400">
          <span class="text-2xl opacity-40" aria-hidden="true">◇</span>
          <span>Нет фото</span>
        </div>
      )
    }
  </div>
</a>
