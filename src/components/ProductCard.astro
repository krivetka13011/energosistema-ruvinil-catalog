---
import type { CatalogProduct } from "../types/catalog";
import { baseUrl } from "../utils/baseUrl";
import { productPrimaryImage } from "../utils/catalog";
import { catalogCartPriceLabelForCart, catalogCartUnitPriceRub } from "../utils/price";
import AddToCartButton from "./AddToCartButton.astro";

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;
const sku = product.properties["Артикул"] ?? "";
const img = productPrimaryImage(product);
const unitRub = catalogCartUnitPriceRub(product);
const priceLabel = catalogCartPriceLabelForCart(product);
---

<div
  class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-brand-600/25 hover:shadow-soft reveal"
>
  <a href={baseUrl(`/p/${product.slug}/`)} class="flex flex-1 flex-col outline-none ring-brand-600/50 focus-visible:ring-2">
    <div class="relative aspect-[4/3] overflow-hidden bg-white">
      {
        img ? (
          <img
            src={img}
            alt={product.title}
            class="supplier-category-photo h-full w-full min-h-0 min-w-0"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-sm text-slate-400">Нет фото</div>
        )
      }
      {sku ? (
        <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-brand-900/90 px-2 py-0.5 text-[11px] font-medium text-white backdrop-blur-sm">
          арт. {sku}
        </span>
      ) : null}
    </div>
    <div class="flex flex-1 flex-col gap-2 bg-white p-4">
      <h3 class="line-clamp-3 font-display text-base font-semibold leading-snug text-brand-950 group-hover:text-brand-700">
        {product.title}
      </h3>
      {
        product.priceHint ? (
          <p class="text-sm font-medium text-accent">{product.priceHint}</p>
        ) : (
          <p class="text-sm text-slate-500">Оптовые цены уточняйте</p>
        )
      }
      {
        product.properties["Опт. прайс, руб."] && !product.slug.startsWith("price-list__") ? (
          <p class="text-sm font-semibold text-brand-900">
            Опт. по прайсу: {product.properties["Опт. прайс, руб."]} ₽
          </p>
        ) : null
      }
      {product.availability ? <p class="text-xs text-emerald-700">{product.availability}</p> : null}
    </div>
  </a>
  <div class="border-t border-slate-100 bg-white px-4 py-3">
    <AddToCartButton
      slug={product.slug}
      title={product.title}
      sku={sku}
      image={img}
      unitPriceRub={unitRub}
      priceDisplay={priceLabel}
    />
  </div>
</div>
