---
import type { CatalogProduct } from "../types/catalog";

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;
const sku = product.properties["Артикул"] ?? "";
---

<a
  href={`/p/${product.slug}/`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-brand-600/25 hover:shadow-soft reveal"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
    {
      product.image ? (
        <img
          src={product.image}
          alt={product.title}
          class="h-full w-full object-contain p-4 transition duration-500 group-hover:scale-[1.03]"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-sm text-slate-400">Нет фото</div>
      )
    }
    {sku ? (
      <span class="absolute left-3 top-3 rounded-full bg-brand-900/90 px-2 py-0.5 text-[11px] font-medium text-white backdrop-blur-sm">
        арт. {sku}
      </span>
    ) : null}
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="line-clamp-3 font-display text-base font-semibold leading-snug text-brand-950 group-hover:text-brand-700">
      {product.title}
    </h3>
    {
      product.priceHint ? (
        <p class="text-sm font-medium text-accent">{product.priceHint}</p>
      ) : (
        <p class="text-sm text-slate-500">Цену уточняйте</p>
      )
    }
    {product.availability ? <p class="text-xs text-emerald-700">{product.availability}</p> : null}
  </div>
</a>
