---
interface Props {
  slug: string;
  title: string;
  sku: string;
  image?: string;
  class?: string;
}

const { slug, title, sku, image = "", class: className = "" } = Astro.props;
const payload = Buffer.from(JSON.stringify({ slug, title, sku, image })).toString("base64");
---

<button
  type="button"
  data-cart-add
  data-item={payload}
  class:list={[
    "flex w-full items-center justify-center rounded-xl px-4 py-3 text-center text-sm font-semibold shadow-md transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 sm:text-base",
    "bg-brand-600 text-white hover:bg-brand-700",
    "aria-[pressed=true]:bg-emerald-700 aria-[pressed=true]:hover:bg-emerald-800",
    className,
  ]}
  aria-pressed="false"
>
  <span data-cart-label>Добавить товар в корзину</span>
</button>
