---
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = "" } = Astro.props;
---

<button
  type="button"
  data-compare-btn
  data-slug={slug}
  class:list={[
    "flex w-full items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-brand-900 shadow-sm transition hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 sm:text-base",
    "aria-pressed:border-brand-600 aria-pressed:bg-brand-50 aria-pressed:text-brand-800",
    className,
  ]}
>
  <span data-compare-text>Добавить в сравнение</span>
</button>

<script>
  import { getCompareItems, addToCompare, removeFromCompare } from "../scripts/compare-storage";

  function updateBtn(btn: HTMLButtonElement) {
    const slug = btn.dataset.slug;
    if (!slug) return;
    const isComp = getCompareItems().includes(slug);
    btn.setAttribute("aria-pressed", isComp.toString());
    const textEl = btn.querySelector("[data-compare-text]");
    if (textEl) {
      textEl.textContent = isComp ? "В сравнении" : "Добавить в сравнение";
    }
  }

  function bind() {
    const btns = document.querySelectorAll<HTMLButtonElement>("[data-compare-btn]:not([data-compare-bound])");
    btns.forEach((btn) => {
      btn.dataset.compareBound = "1";
      updateBtn(btn);
      btn.addEventListener("click", () => {
        const slug = btn.dataset.slug;
        if (!slug) return;
        if (btn.getAttribute("aria-pressed") === "true") {
          removeFromCompare(slug);
        } else {
          addToCompare(slug);
        }
      });
    });
  }

  bind();
  document.addEventListener("astro:after-swap", bind);
  window.addEventListener("compare:updated", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-compare-btn]").forEach(updateBtn);
  });
</script>
